#==============================================================================
# CMake Rules
# ==============================================================================
# Ignore the build directories generated by CMake
/build/
/build*/
/out/
/out*/

# Ignore cache, check, and temporary files generated during configuration
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ==============================================================================
# Visual Studio / MSVC Rules
# ==============================================================================
# User-specific CMake settings or configurations
CMakeSettings.json
CMakeUserPresets.json

# Visual Studio hidden directory containing IntelliSense, local history, and cache
.vs/

# Compiler and Linker output files
*.obj
*.exe
*.pdb
*.ilk
*.lib
*.dll
*.suo
*.user

# ==============================================================================
# Package Managers (Optional)
# ==============================================================================
# Un-comment if you use vcpkg in manifest mode locally
# /vcpkg_installed/